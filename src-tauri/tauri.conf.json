{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pulse",
  "version": "0.1.6",
  "identifier": "dev.pulse.strip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "pulse",
        "width": 960,
        "height": 440,
        "minWidth": 960,
        "minHeight": 440,
        "maxWidth": 1920,
        "maxHeight": 440,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEQjAxMkNFQUQ2MzM2QzQKUldURU5tT3R6aEt3L2Vqb1R2VndBbXNxMy9sMkFBcVdRdUVSdndKdlJxdUZydUdaOTcrR2dGRnIK",
      "endpoints": [
        "https://github.com/Randy-L-Thomas/pulse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
